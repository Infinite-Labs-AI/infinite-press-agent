{
  "name": "infinite-press-agent",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first press opportunity scanner and pitching agent, starting with Qwoted.",
  "type": "module",
  "bin": {
    "infinite-press-agent": "./bin/infinite-press-agent.js"
  },
  "files": [
    "AGENTS.md",
    ".env.example",
    "bin",
    "docs",
    "LICENSE",
    "src",
    "tests",
    "README.md"
  ],
  "scripts": {
    "qwoted": "node bin/infinite-press-agent.js run --limit 40 --max-submit 1 --min-score 80",
    "qwoted:once": "node bin/infinite-press-agent.js run --once --limit 40 --max-submit 1 --min-score 80",
    "qwoted:dry": "node bin/infinite-press-agent.js run --once --dry-run --debug --limit 40 --max-submit 1 --min-score 80",
    "qwoted:login": "node bin/infinite-press-agent.js init",
    "qwoted:install": "node bin/infinite-press-agent.js install",
    "qwoted:status": "node bin/infinite-press-agent.js status",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "scan": "node bin/infinite-press-agent.js scan",
    "run": "node bin/infinite-press-agent.js run",
    "init": "node bin/infinite-press-agent.js init"
  },
  "dependencies": {
    "puppeteer-core": "^25.7.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
