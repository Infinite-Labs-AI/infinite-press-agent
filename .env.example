# Optional: where runtime state is stored.
# INFINITE_PRESS_AGENT_HOME="$HOME/.infinite-press-agent"

# Optional: override Chrome executable path.
# QWOTED_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Optional: auth/signup URL. Defaults to Qwoted source requests, which redirects to auth if needed.
# QWOTED_AUTH_URL="https://app.qwoted.com/source_requests"

# Required for useful ranking/pitching.
QWOTED_EXPERT_NAME="Example Expert"
QWOTED_EXPERT_CONTEXT="Founder/operator with credible experience in the topics below."
QWOTED_EXPERT_CAN_PITCH="AI agents, workflow automation, B2B SaaS, marketing operations"
QWOTED_EXPERT_REJECT="medical, legal, financial, licensed expert asks, product roundups, personal anecdotes, anything requiring fake credentials"

# Optional tuning.
QWOTED_MIN_SCORE=80
QWOTED_MAX_SUBMIT=1

# Optional Codex overrides.
# QWOTED_CODEX_BIN="codex"
# QWOTED_CODEX_MODEL=""
